# --- where things live ---------------------------------------------------
BACKEND_URL=http://localhost:4000
NETWORK=testnet                      # testnet | public
SOROBAN_RPC_URL=                     # default follows NETWORK
HORIZON_URL=                         # default follows NETWORK
ORACLE_CONTRACT_ID=                  # the escrow contract (C…)
USDC_ASSET_CODE=USDC
USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
TIMEOUT_LEDGERS=100                  # contract refund_timeout window

# --- keys (testnet only! never commit real keys) --------------------------
# Asker key for `plumb ask` / scenarios. DEMO_PAYER_SECRET is accepted too.
PAYER_SECRET=
# Optional verifier key for `plumb verifier`. Without it the verifier uses a
# plain test id (fine for sandbox dispatch, but it can't stake or withdraw).
WORKER_SECRET=
# Funded USDC holder used by `plumb sponsored-proof` to seed a fresh account.
FUNDING_PAYER_SECRET=

# --- chat bot -------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
