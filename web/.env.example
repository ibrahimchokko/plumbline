# Where the Plumbline/Arbiter-compatible backend lives.
VITE_BACKEND_URL=http://localhost:4000

# "testnet" or "public". Drives the passphrase, Horizon/RPC defaults and explorer links.
VITE_NETWORK=testnet
# Optional overrides (defaults follow VITE_NETWORK).
VITE_HORIZON_URL=
VITE_SOROBAN_RPC_URL=

VITE_USDC_ASSET_CODE=USDC
VITE_USDC_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
VITE_ORACLE_CONTRACT_ID=

# Hardware wallet adapter (adds ~300 KB, loaded only when someone picks it).
VITE_ENABLE_LEDGER=false

# Optional telemetry — both are complete no-ops when empty.
VITE_SENTRY_DSN=

# Optional remote feature flags (Unleash frontend API). Otherwise /flags.json is used.
VITE_UNLEASH_URL=
VITE_UNLEASH_CLIENT_KEY=
